manifest {
    name            = 'snigron'
    description     = 'SNPs, indels and integrons in bacterial genome assemblies'
    author          = 'Mario García Calleja'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '2.0.0'
}

params {
    samplesheet    = null       // CSV: sample,fasta
    comparisons    = null       // CSV: comparison,control,treated
    reference      = null       // reference genome FASTA
    regions        = null       // BED of regions of interest
    func_hmm_dir   = null       // optional directory of pressed HMMs (Resfams, Pfam...) for IntegronFinder
    skip_integrons = false
    flank          = 200        // bp upstream of each region also reported
    outdir         = 'results'
    slurm_queue    = null
}

includeConfig 'conf/base.config'

profiles {
    test {
        params.samplesheet = "${projectDir}/tests/data/samplesheet.csv"
        params.comparisons = "${projectDir}/tests/data/comparisons.csv"
        params.reference   = "${projectDir}/tests/data/reference.fasta"
        params.regions     = "${projectDir}/tests/data/regions.bed"
        process.resourceLimits = [cpus: 2, memory: '4.GB']
    }
}
