/*
 * Resources and execution profiles.
 * Tune max_cpus / max_memory to your machine, e.g. --max_cpus 32 --max_memory 250.GB
 */

params {
    max_cpus     = 16
    max_memory   = '64.GB'
    publish_mode = 'copy'
}

process {
    cpus   = 1
    memory = '4.GB'
    errorStrategy = 'terminate'   // fail loudly: a missing sample must never go unnoticed

    // Every request is capped to --max_cpus / --max_memory
    resourceLimits = [cpus: params.max_cpus as int, memory: params.max_memory]

    withLabel: 'process_low'    { cpus = 2;  memory = '8.GB'  }
    withLabel: 'process_medium' { cpus = 8;  memory = '32.GB' }
    withLabel: 'process_high'   { cpus = 64; memory = '256.GB' }
    withLabel: 'process_gpu'    { cpus = 64; memory = '256.GB' }
}

profiles {
    conda {
        conda.enabled = true
    }
    mamba {
        conda.enabled  = true
        conda.useMamba = true
    }
    micromamba {
        conda.enabled       = true
        conda.useMicromamba = true
    }
    slurm {
        process.executor = 'slurm'
        process.queue    = { params.slurm_queue ?: null }
    }
}

timeline.enabled = true
report.enabled   = true
trace.enabled    = true
timeline.file    = "${params.outdir}/pipeline_info/timeline.html"
report.file      = "${params.outdir}/pipeline_info/report.html"
trace.file       = "${params.outdir}/pipeline_info/trace.tsv"
timeline.overwrite = true
report.overwrite   = true
trace.overwrite    = true
